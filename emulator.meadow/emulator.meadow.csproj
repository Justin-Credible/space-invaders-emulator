<Project Sdk="Meadow.Sdk/1.1.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <AssemblyName>App</AssemblyName>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>JustinCredible.SIEmulator.Meadow</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meadow.Foundation" Version="2.5.0" />
    <PackageReference Include="Meadow.Foundation.Graphics.MicroGraphics" Version="2.0.1" />
    <PackageReference Include="Meadow.Foundation.Displays.TftSpi" Version="2.0.1" />
    <PackageReference Include="Meadow.F7" Version="2.5.0" />
    <ProjectReference Include="..\emulator\emulator.csproj" />
  </ItemGroup>
  <ItemGroup>
      <None Include="meadow.config.yaml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Include="app.config.yaml">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
  </ItemGroup>
</Project>
